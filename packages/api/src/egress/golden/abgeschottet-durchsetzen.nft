# Airlock: Ausgang der Projekt-Netze. Erzeugt von Airlock (egress/rules.ts), nicht von Hand aendern.
table inet airlock {
  chain egress {
    type filter hook forward priority -1; policy accept;
    iifname "br-0a1b2c3d4e5f" jump p_0a1b2c3d4e5f
  }
  chain egress_host {
    type filter hook input priority -1; policy accept;
    iifname "br-0a1b2c3d4e5f" jump h_0a1b2c3d4e5f
  }
  # air_shop abgeschottet durchsetzen
  chain p_0a1b2c3d4e5f {
    ct state established,related return
    oifname "br-0a1b2c3d4e5f" return
    limit rate 20/minute burst 20 packets log group 7802
    reject with icmpx admin-prohibited
  }
  chain h_0a1b2c3d4e5f {
    ct state established,related return
    meta l4proto ipv6-icmp return
    limit rate 20/minute burst 20 packets log group 7802
    reject with icmpx admin-prohibited
  }
}
