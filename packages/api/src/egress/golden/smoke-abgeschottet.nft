# Airlock: Ausgang der Projekt-Netze. Erzeugt von Airlock (egress/rules.ts), nicht von Hand aendern.
table inet airlock_smoke {
  chain egress {
    type filter hook forward priority -1; policy accept;
    iifname "br-5e0b0000c0de" jump p_5e0b0000c0de
  }
  chain egress_host {
    type filter hook input priority -1; policy accept;
    iifname "br-5e0b0000c0de" jump h_5e0b0000c0de
  }
  # air_smoke abgeschottet durchsetzen
  chain p_5e0b0000c0de {
    ct state established,related return
    oifname "br-5e0b0000c0de" return
    ip daddr 192.0.2.80 tcp dport 18080 return
    limit rate 20/minute burst 20 packets log group 7812
    reject with icmpx admin-prohibited
  }
  chain h_5e0b0000c0de {
    ct state established,related return
    meta l4proto ipv6-icmp return
    ip daddr 192.0.2.80 tcp dport 18080 return
    limit rate 20/minute burst 20 packets log group 7812
    reject with icmpx admin-prohibited
  }
}
