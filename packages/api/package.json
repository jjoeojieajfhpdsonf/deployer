    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.0.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dockerode": "^4.0.4",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "tar-fs": "^3.1.3",
    "tar-stream": "^3.2.2",
    "undici": "^7.2.0",
    "yaml": "^2.9.1",
    "yauzl": "^3.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.34",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/tar-fs": "^2.0.4",
    "@types/tar-stream": "^3.1.5",
    "@types/yauzl": "^2.10.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
