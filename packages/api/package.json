{
  "name": "@deployer/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "e2e": "tsx --test --test-concurrency=1 --test-timeout=900000 \"e2e/*.e2e.ts\""
  },
  "dependencies": {
    "@balena/dockerignore": "^1.0.2",
    "@deployer/shared": "workspace:*",
