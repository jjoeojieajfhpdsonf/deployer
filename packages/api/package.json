{
  "name": "@airlock/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "e2e": "tsx --test --test-concurrency=1 --test-timeout=900000 \"e2e/*.e2e.ts\"",
    "e2e:backup": "tsx scripts/backup-e2e.ts",
    "e2e:cf": "docker compose -f ../../compose.yaml -f e2e/compose.cf-fake.yaml --project-directory ../.. up -d --build airlock && sleep 8 && E2E_CF_FAKE=1 tsx --test --test-concurrency=1 --test-timeout=900000 e2e/m5.e2e.ts; rc=$?; docker compose -f ../../compose.yaml --project-directory ../.. up -d airlock; exit $rc"
  },
  "dependencies": {
    "@balena/dockerignore": "^1.0.2",
    "@airlock/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.0.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dockerode": "^4.0.4",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.1",
    "nodemailer": "^10.3.1",
    "pg": "^8.13.1",
    "tar-fs": "^3.1.3",
    "tar-stream": "^3.2.2",
    "undici": "^7.2.0",
    "yaml": "^2.9.1",
    "yauzl": "^3.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.34",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/smtp-server": "^3.5.13",
    "@types/tar-fs": "^2.0.4",
    "@types/tar-stream": "^3.1.5",
    "@types/yauzl": "^2.10.3",
    "smtp-server": "^3.21.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
