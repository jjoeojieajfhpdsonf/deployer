{
  "name": "@airlock/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p visual/tsconfig.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:visual": "playwright test -c visual/playwright.config.ts",
    "test:visual:update": "playwright test -c visual/playwright.config.ts --update-snapshots=changed",
    "test:a11y": "playwright test -c visual/playwright.config.ts a11y keyboard",
    "preview": "vite preview"
  },
  "dependencies": {
    "@airlock/shared": "workspace:*",
    "@codemirror/commands": "6.9.0",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/language": "6.11.3",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.6",
    "@fontsource/cal-sans": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@lezer/highlight": "1.2.1",
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/react-query": "^5.62.11",
    "canvas-confetti": "1.9.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "sonner": "2.0.7",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "22.20.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.65.0",
    "tsx": "4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
