{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-shell-file-edits.mjs\"",
            "timeout": 10,
            "statusMessage": "Prüfe: Projektdateien nur mit Edit/Write"
          }
        ]
      }
    ]
  }
}
