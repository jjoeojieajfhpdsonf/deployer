# --- Datenbank -------------------------------------------------------------
POSTGRES_PASSWORD=bitte-aendern

# --- Adressen --------------------------------------------------------------
# Basisdomain, HTTPS und Tunnel richtest du in der Oberfläche ein:
# System -> «Cloudflare verbinden» (siehe docs/CLOUDFLARE.md). Bis dahin ist
# die nip.io-Adresse die Hauptadresse.
#
# Alt, nur noch als Rückfall: INTERNAL_BASE_DOMAIN, TLS_MODE, ACME_CA,
# ACME_EMAIL, TAILSCALE_IP, CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_TUNNEL_ID,
# ACCESS_EMAIL (mit compose.tls.yaml / compose.public.yaml).
# LAN-IP des Servers: auf Linux leer lassen, deployer erkennt sie (und die
# Tailscale-IP) selbst, beim Start und stündlich. Nur für Docker Desktop auf
# dem Mac nötig ("pnpm ip"). Siehe docs/INSTALL.md.
SERVER_LAN_IP=
# Rueckfall ueber nip.io: <slug>.<ip-mit-bindestrichen>.nip.io
NIPIO_FALLBACK=on

# --- IP-Filter -------------------------------------------------------------
# on  = nur LAN-Netz + Tailnet erreichen interne Hostnamen (Vorgabe, Server)
#       Das LAN-Netz erkennt deployer auf Linux selbst; LAN_CIDR ist der Rückfall.
# off = kein Filter. NUR fuer Docker Desktop auf dem Mac, siehe MILESTONE-1.md
CADDY_IP_FILTER=on
LAN_CIDR=192.168.1.0/24

# --- Login -----------------------------------------------------------------
# Beim ersten Start gesetzt und danach als Hash in der DB abgelegt.
ADMIN_PASSWORD=bitte-aendern
SESSION_SECRET=

# --- Limits ----------------------------------------------------------------
DEFAULT_CPU_LIMIT=1
DEFAULT_MEMORY_LIMIT_MB=512
